# ============================================
# AutoML Agent — environment variables
# ============================================

# --- API ---
API_HOST=0.0.0.0
API_PORT=8100
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# --- Celery / Redis ---
CELERY_BROKER_URL=redis://localhost:6479/0
CELERY_RESULT_BACKEND=redis://localhost:6479/0

# --- Database (PostgreSQL) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=automl

# URL for commands and the backend running on the host.
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5433/automl

# URL injected into the backend, worker, and migration containers.
# URL-encode special characters in the password (for example, @ becomes %40).
DATABASE_URL_DOCKER=postgresql+psycopg2://postgres:postgres@postgres:5432/automl

# LLM settings
LLM_PROVIDER=ollama
LLM_MODEL=
LLM_API_KEY=ollama
LLM_BASE_URL=
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=4096
AGENT_MAX_ITERATIONS=8

# --- Data limits ---
MAX_FILE_SIZE_MB=200
MAX_ROWS_SAMPLE=100000

# --- ML ---
RANDOM_STATE=42
TEST_SIZE=0.2
VALIDATION_SIZE=0.1
MAX_CANDIDATE_MODELS=5

# --- Frontend ---
VITE_API_URL=http://localhost:8100
