# ============================================
# AutoML Agent — Example Environment Variables
# Copy to .env and adjust as needed.
# ============================================

# ---------- App Settings ----------
ENVIRONMENT=development
APP_NAME=AutoML Agent
APP_BASE_URL=http://localhost:8100
FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:8100

# --- API ---
API_HOST=0.0.0.0
API_PORT=8100
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# --- Celery / Redis ---
CELERY_BROKER_URL=redis://localhost:6479/0
CELERY_RESULT_BACKEND=redis://localhost:6479/0

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5433/automl

# ---------- LLM / Agent ----------
LLM_PROVIDER=ollama
LLM_MODEL=qwen3:14b
LLM_API_KEY=ollama
LLM_BASE_URL=http://localhost:11434
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=4096
AGENT_MAX_ITERATIONS=8

# ---------- Auth (JWT) ----------
SECRET_KEY=CHANGE_ME_IN_PRODUCTION_USE_A_STRONG_32_CHAR_SECRET
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ---------- Google OAuth ----------
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:8100/api/auth/google/callback

# ---------- Email (Resend) ----------
RESEND_API_KEY=your_resend_api_key_here
EMAIL_FROM=onboarding@resend.dev
EMAIL_FROM_NAME=AutoML Support
EMAIL_VERIFY_SUBJECT=Verify your AutoML Account

# ---------- Data limits & ML ----------
MAX_FILE_SIZE_MB=200
MAX_ROWS_SAMPLE=100000
RANDOM_STATE=42
TEST_SIZE=0.2
VALIDATION_SIZE=0.1
MAX_CANDIDATE_MODELS=5