# ============================================
# AutoML Agent — environment variables
# ============================================

# --- API ---
API_HOST=0.0.0.0
API_PORT=8100
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# --- Celery / Redis ---
CELERY_BROKER_URL=redis://localhost:6479/0
CELERY_RESULT_BACKEND=redis://localhost:6479/0

# --- Database (PostgreSQL) ---
# Note: we use port 5433 here to avoid conflict with rf_postgres (5432)
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5433/AutoML

# LLM settings
LLM_PROVIDER=ollama
LLM_MODEL=
LLM_API_KEY=ollama
LLM_BASE_URL=
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=4096
AGENT_MAX_ITERATIONS=8

# --- Data limits ---
MAX_FILE_SIZE_MB=200
MAX_ROWS_SAMPLE=100000

# --- ML ---
RANDOM_STATE=42
TEST_SIZE=0.2
VALIDATION_SIZE=0.1
MAX_CANDIDATE_MODELS=5

# --- Frontend ---
VITE_API_URL=http://localhost:8100