# AutoML Agent example settings. No real credentials belong in this file.

# ---------- App Settings ----------
ENVIRONMENT=development
APP_NAME=AutoML Agent
APP_BASE_URL=http://localhost:8100
FRONTEND_URL=http://localhost:3000

# --- API ---
API_HOST=0.0.0.0
API_PORT=8100
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# --- PostgreSQL and Compose ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=automl
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5433/automl
DATABASE_URL_DOCKER=postgresql+psycopg2://postgres:postgres@postgres:5432/automl

# --- Celery / Redis ---
CELERY_BROKER_URL=redis://localhost:6479/0
CELERY_RESULT_BACKEND=redis://localhost:6479/0

# ---------- Pipeline Agent (LiteLLM) ----------
LLM_PROVIDER=ollama
LLM_MODEL=qwen3:14b
LLM_API_KEY=ollama
LLM_BASE_URL=http://localhost:11434
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=4096
AGENT_MAX_ITERATIONS=8
AGENT_MAX_TOOL_CALLS=12
AGENT_LLM_TIMEOUT_SECONDS=120
AGENT_TOOL_TIMEOUT_SECONDS=600

# ---------- Report Agent (Groq + LangGraph) ----------
REPORT_AGENT_ENABLED=false
REPORT_LLM_PROVIDER=groq
REPORT_LLM_MODEL=openai/gpt-oss-20b
REPORT_LLM_API_KEY=your-groq-api-key
REPORT_LLM_MAX_TOKENS=4096
REPORT_LLM_TIMEOUT_SECONDS=90

# ---------- User-managed AI provider credentials (backend only) ----------
PROVIDER_CREDENTIAL_ENCRYPTION_KEY=REPLACE_WITH_GENERATED_FERNET_KEY
PROVIDER_TEST_TIMEOUT_SECONDS=15

# ---------- Auth (JWT) ----------
SECRET_KEY=CHANGE_ME_IN_PRODUCTION_USE_A_STRONG_32_CHAR_SECRET
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ---------- Google OAuth ----------
# Retained for deployment compatibility; the current code exchange uses the request body's redirect_uri.
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:8100/api/auth/google/callback

# ---------- Email (Resend) ----------
RESEND_API_KEY=your_resend_api_key_here
EMAIL_FROM=onboarding@resend.dev
EMAIL_FROM_NAME=AutoML Support
EMAIL_VERIFY_SUBJECT=Verify your AutoML Account

# ---------- Data limits and ML ----------
MAX_FILE_SIZE_MB=200
MAX_ROWS_SAMPLE=100000
CSV_CHUNK_SIZE=10000
DATASET_MEMORY_WARNING_MB=512
RANDOM_STATE=42
TEST_SIZE=0.2
VALIDATION_SIZE=0.1
MAX_CANDIDATE_MODELS=5
MAX_DENSE_CONVERSION_MB=512
PREDICTION_BATCH_SIZE=256
